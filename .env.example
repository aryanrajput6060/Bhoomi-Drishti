# ---------------------------------------------------------------------------
# JARVIS — required environment variables
# Copy this file to .env and fill in your values.
# The file .env is git-ignored; real secrets stay on your machine.
# ---------------------------------------------------------------------------

# Optional: LLM provider API key
# Recognized environment names:
#   JARVIS_LLM_API_KEY  (preferred)
#   OPENAI_API_KEY      (alias)
# Used by: OpenAI, Anthropic, Gemini, Groq, Together, OpenRouter, DeepSeek
# Leave empty when using a local provider (ollama / lmstudio).
LLM_API_KEY=

# Optional: override the model name when the provider default is not wanted.
# LLM_MODEL=

# Optional: override the base URL for OpenAI-compatible APIs.
# LLM_BASE_URL=

# ---------------------------------------------------------------------------
# Search provider API keys (only one is needed; set the one you actually use)
# ---------------------------------------------------------------------------

# Tavily search
# TAVILY_API_KEY=

# Serper (Google search via API)
# SERPER_API_KEY=

# Brave search
# BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# Home Assistant (optional integration)
# ---------------------------------------------------------------------------

# HOME_ASSISTANT_URL=https://home.example.com
# HOME_ASSISTANT_TOKEN=

# ---------------------------------------------------------------------------
# Webhook (optional)
# ---------------------------------------------------------------------------

# WEBHOOK_URL=
# WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Weather (optional, used by weather skill)
# ---------------------------------------------------------------------------

# DEFAULT_CITY=Bhopal
# WEATHER_LATITUDE=
# WEATHER_LONGITUDE=

# ---------------------------------------------------------------------------
# Developer convenience (optional)
# ---------------------------------------------------------------------------

# PROJECTS_DIR=
# EDITOR_COMMAND=
# TERMINAL_COMMAND=
# BROWSER_COMMAND=
